#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

python3 .audit/scripts/validate_contract.py
python3 .audit/scripts/validate_profiles.py
python3 .audit/scripts/test_profile_routing.py
python3 .audit/scripts/test_request_routing.py
python3 script/test-pinned-composer.py
python3 script/test-target-visibility.py
python3 script/test-runtime-probe.py
python3 script/test-artifact-payload-hygiene.py
python3 script/runtime-branch-cleanup-guard.py --self-test
python3 script/test-evidence-receipt.py
python3 script/test-evidence-receipt-verifier.py

bash -n .audit/scripts/check_target_visibility.sh
bash -n .audit/scripts/install_cli_tools.sh
bash -n .audit/scripts/install_pinned_composer.sh
bash -n .audit/scripts/run_static_audit.sh
bash -n .audit/scripts/runtime_probe.sh
bash -n script/audit
bash -n script/package
bash -n script/playground
bash -n script/test-playground
bash script/test-playground

python3 -c 'from pathlib import Path; compile(Path("script/release-pair-prepare.py").read_text(encoding="utf-8"), "script/release-pair-prepare.py", "exec")'
PYTHONDONTWRITEBYTECODE=1 python3 script/test-release-pair.py
bash -n script/release-pair-runtime.sh

echo "repository validation: OK"
