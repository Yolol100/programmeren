{
  "schema_version": "1.0",
  "id": "ultracache-pro",
  "version": "1.0.0",
  "description": "UltraCache Pro profile. Enables only the cache, WooCommerce, browser and provider probes required by this plugin.",
  "extends": [
    "cache"
  ],
  "capabilities": [
    "wordpress.woocommerce",
    "provider.cloudflare-mock",
    "ultracache.object-cache-dropins",
    "ultracache.runtime-suite"
  ],
  "runtime": {
    "specialized": true,
    "script": ".audit/scripts/integration_runtime_probe.sh",
    "wordpress_plugins": [
      "woocommerce"
    ]
  }
}
