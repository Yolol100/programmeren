{
  "schema_version": "1.2",
  "owner_skill": "wordpressqualityarchitect",
  "project_id": "project-plugin",
  "repository": "Yolol100/programmeren",
  "evidence_role": "controlled_runtime_wordpress_plugin_audit",
  "requires_account": false,
  "requires_api_key": false,
  "requires_mcp": false,
  "profile_routing": {
    "registry": ".audit/profiles/index.json",
    "default_profile": "base",
    "resolver": ".audit/scripts/resolve_profile.py",
    "validator": ".audit/scripts/validate_profiles.py",
    "rule": "General tools run for every audit. Specialized tools, services, WordPress plugins and probes run only through a matched validated plugin profile."
  },
  "tools": [
    {"id":"parallel-lint","version":"composer-lock","scope":"base","trigger_when":"PHP source is present","outputs":["audit-results/php-syntax.log"]},
    {"id":"wpcs","version":"composer-lock","scope":"base","trigger_when":"PHP source is present","outputs":["audit-results/wpcs.log"]},
    {"id":"phpcompatibilitywp","version":"composer-lock","scope":"base","trigger_when":"PHP source is present","outputs":["audit-results/php-compat.log"]},
    {"id":"phpstan-wordpress","version":"composer-lock","scope":"base","trigger_when":"PHP source is present","outputs":["audit-results/phpstan.log"]},
    {"id":"phpunit-project","version":"target-project-declared","scope":"profile-capability","trigger_when":"audit.phpunit-project is active and the target declares phpunit/phpunit with an installed vendor/bin/phpunit","outputs":["audit-results/phpunit.log","audit-results/status.tsv"]},
    {"id":"composer-audit","version":"runner-composer-v2","scope":"base","trigger_when":"composer.lock is present","outputs":["audit-results/composer-audit.log"]},
    {"id":"npm-audit","version":"runner-node","scope":"base","trigger_when":"package-lock.json is present","outputs":["audit-results/npm-audit.log"]},
    {"id":"gitleaks","version":"8.28.0","scope":"base","trigger_when":"every static audit","outputs":["audit-results/gitleaks.json"]},
    {"id":"semgrep-ce","version":"1.170.0","scope":"base","trigger_when":"every static audit","outputs":["audit-results/semgrep.json"]},
    {"id":"trivy","version":"0.74.0","scope":"base","trigger_when":"every full audit","outputs":["audit-results/trivy.json"]},
    {"id":"trivy-sbom","version":"0.74.0","scope":"base","trigger_when":"every full audit","outputs":["audit-results/sbom.cdx.json","audit-results/sbom.cdx.sha256"]},
    {"id":"actionlint","version":"1.7.12","scope":"base","trigger_when":"target contains GitHub Actions","outputs":["audit-results/actionlint.log"]},
    {"id":"zizmor","version":"1.28.0","scope":"base","trigger_when":"target contains GitHub Actions","outputs":["audit-results/zizmor.log"]},
    {"id":"wordpress-plugin-check","version":"action-pinned","scope":"base","trigger_when":"run_runtime is true","outputs":["workflow evidence"]},
    {"id":"wp-env-runtime-probe","version":"repo","scope":"base","trigger_when":"run_runtime is true","outputs":["audit-results runtime evidence"]},
    {"id":"profile-runtime","version":"repo","scope":"matched-profile-only","trigger_when":"run_runtime is true and specialized_runtime is true","outputs":["audit-results/profile-resolution.json","profile-specific runtime evidence"]}
  ],
  "usage_assertions": [
    {"tool":"parallel-lint","path":".audit/scripts/run_static_audit.sh","contains":"parallel-lint"},
    {"tool":"wpcs","path":".audit/scripts/run_static_audit.sh","contains":"--standard=WordPress"},
    {"tool":"phpcompatibilitywp","path":".audit/scripts/run_static_audit.sh","contains":"PHPCompatibilityWP"},
    {"tool":"phpstan-wordpress","path":".audit/scripts/run_static_audit.sh","contains":"phpstan-wordpress"},
    {"tool":"phpunit-project","path":".audit/scripts/run_static_audit.sh","contains":"has_profile_capability audit.phpunit-project"},
    {"tool":"composer-audit","path":".audit/scripts/run_static_audit.sh","contains":"composer audit"},
    {"tool":"npm-audit","path":".audit/scripts/run_static_audit.sh","contains":"npm audit"},
    {"tool":"gitleaks","path":".audit/scripts/run_static_audit.sh","contains":"run_check gitleaks"},
    {"tool":"semgrep-ce","path":".audit/scripts/run_static_audit.sh","contains":"SEMGREP_SEND_METRICS=off"},
    {"tool":"trivy","path":".github/workflows/full-plugin-audit.yml","contains":"Trivy vulnerability and misconfiguration scan"},
    {"tool":"trivy-sbom","path":".github/workflows/full-plugin-audit.yml","contains":"Trivy CycloneDX SBOM"},
    {"tool":"actionlint","path":".audit/scripts/run_static_audit.sh","contains":"run_check actionlint"},
    {"tool":"zizmor","path":".audit/scripts/run_static_audit.sh","contains":"run_check zizmor"},
    {"tool":"wordpress-plugin-check","path":".github/workflows/full-plugin-audit.yml","contains":"WordPress/plugin-check-action"},
    {"tool":"wp-env-runtime-probe","path":".github/workflows/full-plugin-audit.yml","contains":"runtime_probe.sh"},
    {"tool":"profile-runtime","path":".github/workflows/full-plugin-audit.yml","contains":"profile-runtime:"}
  ],
  "boundaries": [
    "Semgrep uses only local repository-owned rules with metrics disabled; no login, token, cloud registry config or MCP server is required or started.",
    "Semgrep Community Edition is a candidate-finding layer; findings require specialist validation and do not automatically prove a vulnerability.",
    "CycloneDX SBOM generation is dependency inventory and provenance evidence; it does not by itself prove dependency safety, license compliance or exploitability.",
    "Target project scripts are not executed generically; runtime probes remain controlled.",
    "Project-owned PHPUnit runs only when audit.phpunit-project is active, phpunit/phpunit is declared by the target and vendor/bin/phpunit is already installed; the audit harness does not install arbitrary target Composer dependencies or select a PHPUnit version for the target.",
    "Profile resolution evidence is required and validated before static audit capability routing; missing or invalid profile evidence fails closed.",
    "Unknown plugins receive the base profile only.",
    "A specialized profile may be selected only by a registry binding and its runtime script must come from the audit harness repository.",
    "Redis, APCu, WooCommerce, provider mocks and other product-specific dependencies are not part of the base audit unless a matching profile explicitly declares them."
  ]
}
